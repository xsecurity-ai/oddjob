# Copy to .env and edit. .env is gitignored; keep it that way.
#
#   cp .env.example .env
#   docker compose up -d

# Required. Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Optional — the defaults are fine for a single deployment.
POSTGRES_USER=oddjob
POSTGRES_DB=oddjob

# Where the host can reach things. Both are loopback on purpose: this
# application has no rate limiting and no brute-force lockout, and the
# database holds findings and captured traffic. Put a VPN or an
# authenticating proxy in front before changing BIND_ADDRESS.
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
POSTGRES_PORT=5433

# The ghost proxy port, used only when `proxy.enabled` is switched on
# in Site Config. Loopback means it is reachable through an SSH tunnel
# and from nowhere else.
#
# Publishing it (0.0.0.0) is only reasonable WITH `proxy.tls_cert` set:
# without a certificate this port speaks SOCKS5, whose username and
# password are plaintext on the wire (RFC 1929), so publishing it puts
# the credential and every proxied byte in the clear on the internet --
# on a route into a client's network.
PROXY_BIND_ADDRESS=127.0.0.1
PROXY_PORT=8443

# Signs session cookies. Leave empty and one is generated into a
# volume on first boot, which is what you want for a single instance.
# Set it (openssl rand -base64 48) only when several replicas must
# accept each other's sessions.
ODDJOB_SECRET=

LOG_LEVEL=info
