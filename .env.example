# Copy to .env and edit. .env is gitignored; keep it that way.
#
#   cp .env.example .env
#   docker compose up -d

# Required. Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Optional — the defaults are fine for a single deployment.
POSTGRES_USER=oddjob
POSTGRES_DB=oddjob

# Where the host can reach things. Both are loopback on purpose: this
# application has no rate limiting and no brute-force lockout, and the
# database holds findings and captured traffic. Put a VPN or an
# authenticating proxy in front before changing BIND_ADDRESS.
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
POSTGRES_PORT=5433

# Signs session cookies. Leave empty and one is generated into a
# volume on first boot, which is what you want for a single instance.
# Set it (openssl rand -base64 48) only when several replicas must
# accept each other's sessions.
ODDJOB_SECRET=

LOG_LEVEL=info
