{
  "name": "oddjob-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test:logic": "node test/hooks.check.mjs && esbuild test/logic.test.ts --bundle --platform=node --format=esm --outfile=/tmp/ms-logic.mjs --log-level=error && node /tmp/ms-logic.mjs && esbuild test/render.test.tsx --bundle --platform=node --format=cjs --jsx=automatic --external:util --external:stream --external:async_hooks --outfile=/tmp/ms-render.cjs --log-level=error && node /tmp/ms-render.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/orbitron": "^5.2.5",
    "@fontsource/share-tech-mono": "^5.2.5",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
